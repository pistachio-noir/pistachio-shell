      "foreground": "#8E8398",
      "bold": true
    },
    "string": "#87937B",
    "number": "#9D8372",
    "operator": "#7A908B",
    "comment": {
      "foreground": "#4A4A4A",
      "italic": true
    },
    "variable.defaultLibrary": {
      "foreground": "#A5544B",
      "italic": true
    },
    "type.defaultLibrary": {
      "foreground": "#A09375",
      "italic": true
    },
    "selfParameter": {
      "foreground": "#A5544B",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
