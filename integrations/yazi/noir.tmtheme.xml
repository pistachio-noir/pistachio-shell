			</dict>
		</dict>
		<dict>
			<key>name</key><string>Comment</string>
			<key>scope</key><string>comment</string>
			<key>settings</key><dict><key>foreground</key><string>#8C8C8C</string></dict>
		</dict>
		<dict>
