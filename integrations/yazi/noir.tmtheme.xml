<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Noir, the Pistachio shell's Colours (made by tools/make-app-themes.py from src/Theme.qml): code in yazi's previews -->
<plist version="1.0">
